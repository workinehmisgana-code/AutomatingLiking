# Copy this file to .env (or .env.local) and fill in real values.
# .env is gitignored — never commit real secrets.

# ── Vercel Blob ───────────────────────────────────────────────
# From: Vercel dashboard → your project → Storage → Blob → .env.local
BLOB_READ_WRITE_TOKEN=

# ── Upload security ───────────────────────────────────────────
# Any random string — must match UPLOAD_SECRET in upload.py
UPLOAD_SECRET=

# ── Set only when running upload.py locally ───────────────────
# DASHBOARD_URL=https://your-project.vercel.app

# ── Neon Postgres (Better Auth + per-user click tracking) ─────
# From your Neon project's "Connection string" (pooled). Keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ── Better Auth ───────────────────────────────────────────────
# A long random string. Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# The app's base URL. Local dev: http://localhost:3000
# Production: your deployed URL, e.g. https://your-project.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth (Google Cloud Console → Credentials → OAuth client ID)
# Authorized redirect URI to register:
#   {BETTER_AUTH_URL}/api/auth/callback/google
# e.g. http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Groq (AI comment rewriting) ───────────────────────────────
# API key from https://console.groq.com/keys . Used to rewrite the /comments
# click-to-copy comments into fresh short variants every 24h (model:
# openai/gpt-oss-120b). Without it, the static comments in lib/comments.ts show.
GROQ_API_KEY=

# ── Cron protection ───────────────────────────────────────────
# Any random string. Vercel Cron sends it as `Authorization: Bearer <secret>`
# to /api/cron/comments so outsiders can't trigger regeneration.
# Generate with:  openssl rand -base64 32
CRON_SECRET=

# ── Links export token (Android "Next bubble" app) ────────────
# Any random string. The app's Config.kt EXPORT_TOKEN must match this.
# Guards GET /api/links/export which returns all links as plain text.
LINKS_EXPORT_TOKEN=
