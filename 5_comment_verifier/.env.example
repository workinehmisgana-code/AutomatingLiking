# The dashboard base URL (no trailing slash).
DASHBOARD_URL=https://comments-delta-sand.vercel.app

# Shared secret — must EXACTLY match VERIFY_SECRET in the dashboard's env
# (Vercel → Settings → Environment Variables). This authorizes the checker to
# read the verify-list and post results without a browser login.
VERIFY_SECRET=

# Persistent Chrome profile dir (carries cookies so TikTok is less likely to
# block). Reuse the scraper's profile by pointing this at it, or let it create a
# fresh one here on first run.
BROWSER_PROFILE_DIR=./browser_profile

# How many days a user stays valid once found (spec: one week).
VALID_DAYS=7

# Comment-loading knobs (raise if your connection is slow).
MAX_COMMENT_SCROLLS=25
COMMENTS_LOAD_TIMEOUT_MS=45000
PER_SCROLL_WAIT=1.2
