<?xml version="1.0" encoding="utf-8"?>
<!-- The bubble in comment removal mode: deep red with a bright red edge, so it
     cannot be mistaken for the normal (dark grey / green) commenting bubble. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="26dp" />
    <solid android:color="#F23B0A0A" />
    <stroke
        android:width="2dp"
        android:color="#FFEF4444" />
</shape>
